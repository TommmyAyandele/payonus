# Webhook that receives website leads (sales, lead-capture, support, lead-magnet forms)
# as flat JSON — see the LeadPayload shape in app/api/sales-enquiry/route.ts.
# Despite the variable name, this no longer points at a Google Sheet: leads are
# forwarded into Slack by the integration on the receiving end (owned outside this
# repo — ask marketing/ops for the current URL). It must accept this route's flat
# JSON schema, not raw Slack Block Kit — a bare Slack Incoming Webhook URL will
# reject the payload as-is. Set this in your hosting environment (Vercel/etc).
# Without it, form submissions return 500 "Not configured".
GOOGLE_SHEET_WEBHOOK_URL=https://example.com/lead-intake-webhook
